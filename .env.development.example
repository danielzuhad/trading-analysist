NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://<fill-dev-api-host>:3001

POSTGRES_DB=<fill-dev-db-name>
POSTGRES_USER=<fill-dev-db-user>
POSTGRES_PASSWORD=<fill-dev-db-password>
DATABASE_URL=postgresql://<fill-dev-db-user>:<fill-dev-db-password>@<fill-dev-db-host>:5432/<fill-dev-db-name>

REDIS_URL=redis://<fill-dev-redis-host>:6379
WORKER_CONCURRENCY=1
WORKER_ENABLE_SCHEDULER=true
WORKER_SCHEDULED_ASSETS=crypto:global:BTC-USD,crypto:global:ETH-USD,crypto:global:SOL-USD
WORKER_SCHEDULED_TIMEFRAMES=4H
OPENAI_API_KEY=<fill-openai-api-key>
COINGECKO_API_KEY=<fill-coingecko-api-key>
MAX_DAILY_AI_COST_USD=2.00
RUN_INFRA_TESTS=false
