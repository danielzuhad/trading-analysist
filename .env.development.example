NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

POSTGRES_DB=<fill-dev-db-name>
POSTGRES_USER=<fill-dev-db-user>
POSTGRES_PASSWORD=<fill-dev-db-password>
DATABASE_URL=postgresql://<fill-dev-db-user>:<fill-dev-db-password>@127.0.0.1:5432/<fill-dev-db-name>

REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=1
RUN_INFRA_TESTS=false
