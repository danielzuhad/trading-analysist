{
  "name": "trading-analyst",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-turbo.mjs dev --node-env development",
    "build": "node scripts/run-turbo.mjs build",
    "lint": "node scripts/run-turbo.mjs lint",
    "lint:fix": "node scripts/run-turbo.mjs lint -- --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "prepare": "node .husky/install.mjs",
    "start:api": "NODE_ENV=production bun run --cwd apps/api start",
    "start:web": "NODE_ENV=production bun run --cwd apps/web start",
    "start:worker": "NODE_ENV=production bun run --cwd apps/worker start",
    "typecheck": "node scripts/run-turbo.mjs typecheck",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  }
}
