# --- App ---
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
# Generate with: openssl rand -hex 32. Required in production.
API_AUTH_TOKEN=<fill-api-auth-token>
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://<fill-production-domain>

# --- Database & Redis ---
POSTGRES_DB=<fill-production-db-name>
POSTGRES_USER=<fill-production-db-user>
POSTGRES_PASSWORD=<fill-production-db-password>
DATABASE_URL=postgresql://<fill-production-db-user>:<fill-production-db-password>@<fill-production-db-host>:5432/<fill-production-db-name>
REDIS_URL=redis://<fill-production-redis-host>:6379

# --- Worker ---
WORKER_CONCURRENCY=1
WORKER_ENABLE_SCHEDULER=true
WORKER_SCHEDULED_ASSETS=crypto:global:BTC-USD,crypto:global:ETH-USD,crypto:global:SOL-USD
WORKER_SCHEDULED_TIMEFRAMES=4H
WORKER_ENABLE_THRESHOLD_CHECKS=true
WORKER_THRESHOLD_CHECK_INTERVAL_MINUTES=15
WORKER_ENABLE_OUTCOME_EVALUATION=true
WORKER_MAX_AI_ASSETS=10

# --- AI ---
OPENAI_API_KEY=<fill-openai-api-key>
MAX_DAILY_AI_COST_USD=2.00

# --- Market data ---
COINGECKO_API_KEY=<fill-coingecko-api-key>
COINGECKO_API_PLAN=demo

# --- Chat layer (Telegram) ---
TELEGRAM_BOT_TOKEN=<fill-telegram-bot-token>
TELEGRAM_CHAT_ID=<fill-telegram-chat-id>
# Generate with: openssl rand -hex 24. Used to verify inbound Telegram webhooks.
TELEGRAM_WEBHOOK_SECRET=<fill-telegram-webhook-secret>

# --- Chat layer (Twilio WhatsApp, legacy) ---
TWILIO_ACCOUNT_SID=<fill-twilio-account-sid>
TWILIO_AUTH_TOKEN=<fill-twilio-auth-token>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+628123456789
TWILIO_WEBHOOK_URL=https://<fill-production-domain>/chat-layer/twilio/webhook

# --- Tests ---
RUN_INFRA_TESTS=false
