NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
POSTGRES_DB=<fill-db-name>
POSTGRES_USER=<fill-db-user>
